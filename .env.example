# ==========================================
# Codex AI Engineering Workspace - .env.example
# 复制为 .env 后按需填写，密钥不要提交到 git
# ==========================================

# ---------- apps/autonomous-job-agent (Node/TypeScript) ----------
# Web 服务端口
PORT=3456
# SEA 单文件运行根目录
JOB_AGENT_ROOT=
# Web UI 目录
JOB_AGENT_WEB_DIR=web
# 简历目录
JOB_AGENT_RESUME_DIR=resumes
# 用户档案路径
JOB_AGENT_PROFILE_PATH=data/profile.json
# Edge 主登录配置目录
JOB_AGENT_PROFILE_DIR=.edge-profile
# Edge 备用登录配置目录
JOB_AGENT_FALLBACK_PROFILE_DIR=.edge-profile-2
# OCR 语言数据目录
JOB_AGENT_TESSDATA=tessdata
# OCR worker 路径
JOB_AGENT_TESS_WORKER=
# SEA 服务端 bundle 路径
JOB_AGENT_SERVER_BUNDLE=
# dotenv 配置文件路径
DOTENV_CONFIG_PATH=.env
# 禁用自动启动 Edge（1=禁用）
JOB_AGENT_NO_EDGE=0
# 禁用自动打开浏览器（1=禁用）
JOB_AGENT_NO_OPEN=0
# Edge 可执行文件路径（留空自动查找）
EDGE_PATH=
# DeepSeek API Key（对话/打招呼生成）
DEEPSEEK_API_KEY=
# 默认目标岗位
TARGET_ROLE=C++开发工程师

# ---------- apps/autonomous-job-agent (Python 辅助脚本) ----------
# LLM API Key（OpenAI 兼容）
LLM_API_KEY=
# LLM 模型名
LLM_MODEL=
# LLM API 地址
LLM_URL=
# OpenAI API Key
OPENAI_API_KEY=
# Gemini API Key
GEMINI_API_KEY=
# 验证码服务 API Key
CAPSOLVER_API_KEY=
# ApplyPilot 辅助目录
APPLYPILOT_DIR=
# Chrome 可执行文件路径
CHROME_PATH=

# ---------- apps/desktop-agent (Python) ----------
# DeepSeek API Key
DEEPSEEK_API_KEY=

# ---------- apps/manju-system (Python) ----------
# DeepSeek API Key
DEEPSEEK_API_KEY=
# Hugging Face 镜像地址
HF_ENDPOINT=https://huggingface.co

# ---------- Windows 系统变量（一般无需配置） ----------
LOCALAPPDATA=
PROGRAMFILES=
